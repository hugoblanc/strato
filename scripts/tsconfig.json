{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "bun"
    ],
    "lib": [
      "ESNext"
    ],
    "noUnusedLocals": true
  },
  "include": [
    "**/*.ts"
  ]
}
