{
  "owner": { "name": "Alice" },
  "slack": {
    "team": "Acme",
    "workspace": "acme",
    "me": "U_EXAMPLE_ALICE",
    "subteams": ["S_EXAMPLE_PLATFORM"],
    "teamAlias": "@platform",
    "watchChannels": ["C_EXAMPLE_REQUESTS"],
    "ignoreChannels": ["C_EXAMPLE_RANDOM"],
    "ignoreAuthors": ["Deploy Bot", "PagerDuty"],
    "teammates": ["Bob", "Carol"],
    "appId": "A_EXAMPLE_APP",
    "appTokenFile": "~/.config/strato/slack-app.env",
    "pollInterval": 60
  },
  "tracker": { "kind": "linear", "workspace": "acme", "prefixes": ["PLAT", "OPS"] },
  "forge": {
    "kind": "gitlab",
    "host": "gitlab.com",
    "repos": { "api": "acme/api", "web": "acme/web" },
    "aliases": { "backend": "api", "frontend": "web" },
    "iidRanges": [],
    "defaultRepo": "api",
    "integrationBranch": "dev",
    "releaseBranch": "main"
  },
  "workers": {
    "skipPermissions": false,
    "allow": ["mcp__linear__get_issue", "mcp__linear__list_issues", "mcp__linear__list_comments"],
    "shadow": true
  },
  "ui": { "iterm": false, "port": 4343, "slackApp": true, "locale": "en" }
}
